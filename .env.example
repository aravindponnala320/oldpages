# Shared local development settings
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PORT=8000

# API
OLDPAGES_APP_NAME=OldPages API
OLDPAGES_ENVIRONMENT=local
OLDPAGES_DEBUG=true
OLDPAGES_LOG_LEVEL=INFO
OLDPAGES_DATABASE_URL=postgresql+asyncpg://oldpages:oldpages@postgres:5432/oldpages
OLDPAGES_REDIS_URL=redis://redis:6379/0
OLDPAGES_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
OLDPAGES_OBJECT_STORAGE_ENDPOINT=http://minio:9000
OLDPAGES_OBJECT_STORAGE_BUCKET=oldpages-media
OLDPAGES_OBJECT_STORAGE_ACCESS_KEY=oldpages
OLDPAGES_OBJECT_STORAGE_SECRET_KEY=oldpages-secret
OLDPAGES_OTEL_ENABLED=false

# Browser apps
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
