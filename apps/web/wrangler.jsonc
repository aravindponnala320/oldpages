{
  "name": "oldpages-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "NEXT_PUBLIC_API_BASE_URL": "https://oldpages-api.fly.dev",
    "API_BASE_URL": "https://oldpages-api.fly.dev",
    "NEXT_PUBLIC_GOOGLE_CLIENT_ID": "680039030611-0s3tqfd8lri1c3c068g7pn116umlhmvs.apps.googleusercontent.com"
  },
  "routes": [
    { "pattern": "oldpages.in", "custom_domain": true },
    { "pattern": "www.oldpages.in", "custom_domain": true }
  ]
}
